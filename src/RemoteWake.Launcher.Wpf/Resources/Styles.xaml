<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F7FA" />
  <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#132238" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#172335" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#607087" />
  <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentBrush" Color="#167D74" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#116B63" />
  <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="DividerBrush" Color="#DCE3EB" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="#8A4B08" />
  <SolidColorBrush x:Key="DemoBadgeBrush" Color="#DDF5EF" />
  <SolidColorBrush x:Key="DemoBadgeTextBrush" Color="#145C55" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#16836F" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#B13A42" />
  <SolidColorBrush x:Key="ActionBackgroundBrush" Color="#EAF2F7" />

  <Style x:Key="AppTitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="HeaderSubtitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#C7D2DF" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="BodyTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style x:Key="EyebrowStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="StatusValueStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="StatusCardStyle" TargetType="Border">
    <Setter Property="Padding" Value="20" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="125" />
  </Style>
  <Style x:Key="PanelStyle" TargetType="Border" BasedOn="{StaticResource StatusCardStyle}">
    <Setter Property="Padding" Value="24" />
  </Style>
  <Style x:Key="PrimaryButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="156" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFFFFF" /><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
    <Setter Property="Background" Value="#E5EBF1" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#D7E0E8" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TimelineStepStyle" TargetType="StackPanel">
    <Setter Property="Margin" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style x:Key="StepNumberStyle" TargetType="TextBlock">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Padding" Value="0,7,0,0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="StepLabelStyle" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,12,0,0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style x:Key="StepStatusStyle" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,5,0,0" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
