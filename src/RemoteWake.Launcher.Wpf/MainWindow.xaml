<Window x:Class="RemoteWake.Launcher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{DynamicResource AppName}"
        Width="920"
        Height="650"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="40,26,40,22" Background="{StaticResource HeaderBackgroundBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{DynamicResource AppName}"
                     Style="{StaticResource AppTitleStyle}"
                     Focusable="True"
                     KeyboardNavigation.TabIndex="0"
                     automation:AutomationProperties.Name="{DynamicResource AppName}" />
          <TextBlock Margin="0,5,0,0"
                     Text="{DynamicResource HeaderSubtitle}"
                     Style="{StaticResource HeaderSubtitleStyle}" />
        </StackPanel>
        <Border Grid.Column="1"
                Padding="12,7"
                CornerRadius="16"
                Background="{StaticResource DemoBadgeBrush}"
                Visibility="{Binding IsDemo, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Text="{DynamicResource DemoModeLabel}"
                     Foreground="{StaticResource DemoBadgeTextBrush}"
                     FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="40,28">
      <Grid Visibility="{Binding IsDashboardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding ComputerName}"
                   Style="{StaticResource PageTitleStyle}"
                   Focusable="True"
                   KeyboardNavigation.TabIndex="1"
                   automation:AutomationProperties.Name="{DynamicResource ComputerNameAccessibleLabel}" />
        <TextBlock Grid.Row="1"
                   Margin="0,7,0,22"
                   Text="{DynamicResource DashboardSubtitle}"
                   Style="{StaticResource BodyTextStyle}" />

        <UniformGrid Grid.Row="2" Columns="3" Margin="-7,0">
          <Border Style="{StaticResource StatusCardStyle}" Margin="7,0">
            <StackPanel>
              <TextBlock Text="{DynamicResource ComputerStatusLabel}" Style="{StaticResource EyebrowStyle}" />
              <TextBlock Margin="0,12,0,0"
                         Text="{Binding ComputerStatus}"
                         Style="{StaticResource StatusValueStyle}"
                         Focusable="True"
                         automation:AutomationProperties.Name="{DynamicResource ComputerStatusAccessibleLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatusCardStyle}" Margin="7,0">
            <StackPanel>
              <TextBlock Text="{DynamicResource BridgeStatusLabel}" Style="{StaticResource EyebrowStyle}" />
              <TextBlock Margin="0,12,0,0"
                         Text="{Binding BridgeStatus}"
                         Style="{StaticResource StatusValueStyle}"
                         Focusable="True"
                         automation:AutomationProperties.Name="{DynamicResource BridgeStatusAccessibleLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatusCardStyle}" Margin="7,0">
            <StackPanel>
              <TextBlock Text="{DynamicResource ApplicationStatusLabel}" Style="{StaticResource EyebrowStyle}" />
              <TextBlock Margin="0,12,0,0"
                         Text="{Binding ApplicationStatus}"
                         Style="{StaticResource StatusValueStyle}"
                         Focusable="True"
                         automation:AutomationProperties.Name="{DynamicResource ApplicationStatusAccessibleLabel}" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <Grid Grid.Row="3" Margin="0,28,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock>
              <Run Text="{DynamicResource LastCheckedLabel}" />
              <Run Text=" " />
              <Run Text="{Binding LastChecked, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="0,5,20,0"
                       MaxWidth="510"
                       Text="{Binding StartBlockedReason}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource WarningTextBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Command="{Binding RefreshCommand}"
                    Content="{DynamicResource RefreshButtonLabel}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    KeyboardNavigation.TabIndex="5"
                    automation:AutomationProperties.Name="{DynamicResource RefreshButtonAccessibleLabel}" />
            <Button Command="{Binding StartCommand}"
                    Content="{DynamicResource StartButtonLabel}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    KeyboardNavigation.TabIndex="6"
                    automation:AutomationProperties.Name="{DynamicResource StartButtonAccessibleLabel}"
                    automation:AutomationProperties.HelpText="{Binding StartBlockedReason}" />
          </StackPanel>
        </Grid>
      </Grid>

      <Grid Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding PhaseTitle}" Style="{StaticResource PageTitleStyle}" Focusable="True" />
        <StackPanel Grid.Row="1" Margin="0,8,0,22">
          <TextBlock Text="{Binding PhaseDescription}" Style="{StaticResource BodyTextStyle}" />
          <TextBlock Margin="0,4,0,0" Text="{Binding ElapsedText}" Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Style="{StaticResource TimelineStepStyle}">
              <TextBlock Text="1" Style="{StaticResource StepNumberStyle}" />
              <TextBlock Text="{DynamicResource StepRequestLabel}" Style="{StaticResource StepLabelStyle}" />
              <TextBlock Text="{Binding RequestStepStatus}" Style="{StaticResource StepStatusStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Style="{StaticResource TimelineStepStyle}">
              <TextBlock Text="2" Style="{StaticResource StepNumberStyle}" />
              <TextBlock Text="{DynamicResource StepComputerLabel}" Style="{StaticResource StepLabelStyle}" />
              <TextBlock Text="{Binding ComputerStepStatus}" Style="{StaticResource StepStatusStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Style="{StaticResource TimelineStepStyle}">
              <TextBlock Text="3" Style="{StaticResource StepNumberStyle}" />
              <TextBlock Text="{DynamicResource StepWindowsLabel}" Style="{StaticResource StepLabelStyle}" />
              <TextBlock Text="{Binding WindowsStepStatus}" Style="{StaticResource StepStatusStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Style="{StaticResource TimelineStepStyle}">
              <TextBlock Text="4" Style="{StaticResource StepNumberStyle}" />
              <TextBlock Text="{DynamicResource StepClientLabel}" Style="{StaticResource StepLabelStyle}" />
              <TextBlock Text="{Binding ClientStepStatus}" Style="{StaticResource StepStatusStyle}" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,24,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Expander Header="{DynamicResource OperationDetailsLabel}" Foreground="{StaticResource SecondaryTextBrush}">
            <TextBox Margin="0,8,0,0"
                     Text="{Binding CorrelationIdText, Mode=OneWay}"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     automation:AutomationProperties.Name="{DynamicResource CorrelationAccessibleLabel}" />
          </Expander>
          <Button Grid.Column="1"
                  Command="{Binding CancelCommand}"
                  Content="{DynamicResource CancelButtonLabel}"
                  Style="{StaticResource SecondaryButtonStyle}"
                  automation:AutomationProperties.Name="{DynamicResource CancelButtonAccessibleLabel}" />
        </Grid>
      </Grid>

      <Grid Visibility="{Binding IsSuccessVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
          <Border Width="68" Height="68" CornerRadius="34" Background="{StaticResource SuccessBrush}">
            <TextBlock Text="✓" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
          </Border>
          <TextBlock Margin="0,22,0,0" Text="{DynamicResource SuccessTitle}" Style="{StaticResource PageTitleStyle}" TextAlignment="Center" />
          <TextBlock Margin="0,10,0,0" Text="{DynamicResource SuccessDescription}" Style="{StaticResource BodyTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Margin="0,8,0,0" Text="{Binding ElapsedText}" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Center" />
          <StackPanel Margin="0,26,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Command="{Binding BackCommand}" Content="{DynamicResource BackDashboardButtonLabel}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
            <Button Command="{Binding StartCommand}" Content="{DynamicResource OpenAgainButtonLabel}" Style="{StaticResource PrimaryButtonStyle}" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <Grid Visibility="{Binding IsFailureVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
          <Border Width="68" Height="68" CornerRadius="34" Background="{StaticResource ErrorBrush}">
            <TextBlock Text="!" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
          </Border>
          <TextBlock Margin="0,22,0,0" Text="{Binding ErrorTitle}" Style="{StaticResource PageTitleStyle}" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Margin="0,10,0,0" Text="{Binding ErrorConsequence}" Style="{StaticResource BodyTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
          <Border Margin="0,18,0,0" Padding="18" CornerRadius="10" Background="{StaticResource ActionBackgroundBrush}">
            <TextBlock Text="{Binding ErrorAction}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" />
          </Border>
          <Expander Margin="0,18,0,0" Header="{DynamicResource OperationDetailsLabel}" Foreground="{StaticResource SecondaryTextBrush}">
            <StackPanel Margin="0,8,0,0">
              <TextBlock Text="{Binding ErrorCodeText}" FontWeight="SemiBold" />
              <TextBox Margin="0,4,0,0" Text="{Binding CorrelationIdText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
          </Expander>
          <StackPanel Margin="0,26,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Command="{Binding BackCommand}" Content="{DynamicResource BackButtonLabel}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
            <Button Command="{Binding StartCommand}" Content="{DynamicResource RetryButtonLabel}" Style="{StaticResource PrimaryButtonStyle}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Padding="40,13" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
      <TextBlock Text="{DynamicResource PrivacyFooter}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
    </Border>
  </Grid>
</Window>
